{
  "type": "object",
  "required": ["seq", "ts", "kind", "record", "reverts", "files", "prev_sha256", "entry_sha256"],
  "additionalProperties": false,
  "properties": {
    "seq": {"type": "integer", "minimum": 1},
    "ts": {"type": "string"},
    "kind": {"enum": ["approve", "deny", "revert"]},
    "record": {"type": ["object", "null"]},
    "reverts": {"type": ["integer", "null"]},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "before_sha256", "after_sha256"],
        "properties": {
          "path": {"type": "string"},
          "before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "prev_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
