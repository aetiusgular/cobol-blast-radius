//MINIJOB2 JOB 'MINI SUMMARY',CLASS=A,MSGCLASS=0
//*  Sort the newest generation, then sum it.
//STEP1    EXEC PGM=SORT
//SORTIN   DD DISP=SHR,DSN=MINI.OUTFILE(0)
//SYSIN    DD *
 SORT FIELDS=(1,5,CH,A)
/*
