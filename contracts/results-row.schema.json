{
  "type": "object",
  "required": ["run_id", "git_sha", "machine", "model_revision", "quant", "runtime", "date",
               "carddemo_commit", "cobc_version", "split", "split_sha256", "predictor", "kind"],
  "properties": {
    "run_id": {"type": "string"},
    "git_sha": {"type": "string"},
    "machine": {"type": "string", "minLength": 1},
    "model_revision": {"type": ["string", "null"]},
    "quant": {"type": ["string", "null"]},
    "runtime": {"type": ["string", "null"]},
    "date": {"type": "string"},
    "carddemo_commit": {"type": "string"},
    "cobc_version": {"type": "string"},
    "split": {"enum": ["dev", "heldout"]},
    "split_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "predictor": {"type": "string"},
    "kind": {"enum": ["change", "summary"]},
    "change_id": {"type": "string"},
    "class": {"type": "string"},
    "changed": {"type": "array"},
    "predicted": {"type": "array"},
    "excluded": {"type": "boolean"},
    "exclusion_reason": {"type": ["string", "null"]},
    "recall": {"type": ["number", "null"]},
    "precision": {"type": ["number", "null"]}
  }
}
