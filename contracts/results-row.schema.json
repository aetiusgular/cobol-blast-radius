{
  "type": "object",
  "required": ["run_id", "git_sha", "machine", "model_revision", "quant", "runtime", "date",
               "carddemo_commit", "cobc_version", "split", "split_sha256", "predictor", "kind"],
  "properties": {
    "run_id": {"type": "string"},
    "git_sha": {"type": "string"},
    "machine": {"type": "string", "minLength": 1},
    "model_revision": {"type": ["string", "null"]},
    "quant": {"type": ["string", "null"]},
    "runtime": {"type": ["string", "null"]},
    "date": {"type": "string"},
    "carddemo_commit": {"type": "string"},
    "cobc_version": {"type": "string"},
    "split": {"enum": ["dev", "heldout"]},
    "split_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "predictor": {"type": "string"},
    "kind": {"enum": ["change", "summary"]},
    "change_id": {"type": "string"},
    "class": {"type": "string"},
    "changed": {"type": "array"},
    "predicted": {"type": "array"},
    "excluded": {"type": "boolean"},
    "exclusion_reason": {"type": ["string", "null"]},
    "recall": {"type": ["number", "null"]},
    "precision": {"type": ["number", "null"]},
    "git_dirty": {"type": "boolean"},
    "split_matches_contract": {"type": "boolean"},
    "predicted_outside_universe": {"type": ["array", "integer"]},
    "true_positive": {"type": "array"},
    "false_positive": {"type": "array"},
    "false_negative": {"type": "array"},
    "unverifiable": {"type": "array"},
    "status_changes": {"type": "array"},
    "predict_error": {"type": ["string", "null"]},
    "changes": {"type": "integer"},
    "scored": {"type": "integer"},
    "changed_count": {"type": "integer"},
    "predicted_count": {"type": "integer"},
    "hits": {"type": "integer"},
    "per_class": {"type": "object"},
    "noop": {"type": "object"},
    "excluded_by_reason": {"type": "object"},
    "predict_errors": {"type": "integer"}
  }
}
